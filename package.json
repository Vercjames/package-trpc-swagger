{
  "name": "trpc-swagger",
  "license": "MIT",
  "version": "2.0.1",
  "description": "tRPC Swagger Wrapper",
  "author": "https://github.com/vercjames",
  "homepage": "https://github.com/vercjames/package-trpc-swagger",
  "bugs": "https://github.com/vercjames/package-trpc-swagger/issues",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercjames/package-trpc-swagger.git"
  },
  "scripts": {
    "build": "tsup --format cjs,esm --dts",
    "prepublishOnly": "rimraf build && yarn build",
    "format": "eslint --fix \"./packages/**/*.{js,jsx,ts,tsx}\"",
    "lint": "eslint \"./packages/**/*.{js,jsx,ts,tsx}\"",
    "test": "node --experimental-modules --experimental-vm-modules node_modules/.bin/jest --config jest.config.ts"
  },
  "workspaces": [
    ".",
    "examples/with-express",
    "examples/with-fastify",
    "examples/with-interop",
    "examples/with-nextjs",
    "examples/with-nextjs-app",
    "examples/with-nuxtjs",
    "examples/with-serverless"
  ],
  "peerDependencies": {
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "zod": "^3.14.4"
  },
  "dependencies": {
    "chalk-scripts": "^2.0.0",
    "co-body": "^6.2.0",
    "lodash.clonedeep": "^4.5.0",
    "node-mocks-http": "^1.17.2",
    "openapi-types": "^12.1.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/co-body": "^6.1.3",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/mime": "^4.0.0",
    "@types/node": "^20.19.42",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "aws-lambda": "^1.0.7",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "express": "^4.22.2",
    "fastify": "^4.29.1",
    "jest": "^29.7.0",
    "mime": "^4.1.0",
    "next": "^14.2.35",
    "node-fetch": "^2.7.0",
    "openapi-schema-validator": "^12.1.3",
    "semver": "^7.8.4",
    "superjson": "^1.13.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "tsup": {
    "entry": [
      "packages/index.ts"
    ],
    "outDir": "build",
    "splitting": true,
    "sourcemap": true,
    "clean": true
  }
}
