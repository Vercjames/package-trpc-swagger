{
  "name": "package-trpc-swagger",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "eslint --fix .",
    "lint": "eslint .",
    "clean": "rm -rf node_modules packages/*/build packages/*/node_modules apps/*/node_modules apps/*/.next examples/*/node_modules examples/*/.next"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25",
    "eslint": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
